# NHIH Ops Dashboard — Docker Compose environment example
# Copy to `.env` on the server and fill in real secrets before starting.

# PostgreSQL
POSTGRES_USER=nhih
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=nhih_ops
HOST_PORT=8787

# Operator authentication
# REQUIRED for the Visitor Register: MUST be set to a strong, non-default secret.
# The known default code ("nhih-ops") is rejected by all visitor register endpoints.
OPERATOR_CODE=change_this_operator_code

# Visitor Register — Server-side Google Sheets API (read-only service account)
# Share the spreadsheet with the service account email as Viewer (read-only).
GOOGLE_SHEETS_SPREADSHEET_ID=1uf2AK5_YhOZd0bHiigN3TsH-TToR6KMeH1AYiIYW33w
GOOGLE_SHEETS_TAB_NAME=Form Responses 1

# Provide ONE of the following three server-side credential options:
# Option 1 (recommended for Docker): mount the JSON key file read-only and point to it
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-service-account.json
#
# Option 2: inline JSON string of the service account key
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# Option 3: separate email and private key variables
# GOOGLE_SERVICE_ACCOUNT_EMAIL=visitor-reader@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional column header overrides (only needed if the sheet uses non-standard headings)
# GOOGLE_SHEETS_COL_TIMESTAMP=Timestamp
# GOOGLE_SHEETS_COL_NAME=Full Name
# GOOGLE_SHEETS_COL_ORG=Organization or Unit
# GOOGLE_SHEETS_COL_PURPOSE=Purpose of Visit
# Optional date order for ambiguous slash dates (default MDY; set DMY if sheet uses DD/MM/YYYY)
# GOOGLE_SHEETS_DATE_ORDER=MDY
