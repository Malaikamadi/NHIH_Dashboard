# Copy to .env.local for local development. Never commit real secrets.
# For office/server Docker deploy, see docs/DOCKER.md and .env.docker.example.

# Local persistence: PostgreSQL (ignores Upstash Redis / Blob while set)
PERSISTENCE=postgres
DATABASE_URL=postgresql://nhih_local:nhih_local_dev@127.0.0.1:5432/nhih_ops

# Operator desk PIN (local default)
OPERATOR_CODE=nhih-ops

# Do NOT set the following for local Postgres development if you want to
# guarantee zero writes to production. With PERSISTENCE=postgres they are
# ignored by the API, but keeping them out of local env is safer:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# ENABLE_BLOB=
