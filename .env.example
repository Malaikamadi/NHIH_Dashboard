# NHIH Ops Dashboard — Local development environment example
# Copy to `.env.local` and adjust for your machine.

PERSISTENCE=postgres
DATABASE_URL=postgresql://nhih_local:nhih_local_dev@127.0.0.1:5432/nhih_ops
PORT=8787

# REQUIRED for the Visitor Register: must be non-default (not "nhih-ops")
OPERATOR_CODE=change_this_local_operator_code

# Server-side Google Sheets API (read-only service account)
GOOGLE_SHEETS_SPREADSHEET_ID=1uf2AK5_YhOZd0bHiigN3TsH-TToR6KMeH1AYiIYW33w
GOOGLE_SHEETS_TAB_NAME=Form Responses 1

# Provide ONE of:
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
